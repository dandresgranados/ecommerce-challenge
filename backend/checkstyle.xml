<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  ===================================================================
  Checkstyle — reglas razonables para el proyecto TGS.

  No usamos "google_checks.xml" ni "sun_checks.xml" completos porque
  ambos son demasiado estrictos y ruidosos. Aquí solo las reglas que
  aportan valor real y no chocan con Lombok / Spring Boot.

  Para ver los mensajes en el IDE, instala el plugin CheckStyle-IDEA.
  ===================================================================
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java,properties,xml"/>

  <!-- Ficheros no deben terminar con línea en blanco extra. -->
  <module name="NewlineAtEndOfFile"/>

  <!-- Longitud de línea máxima 140 (el default 80 es demasiado corto para Java moderno). -->
  <module name="LineLength">
    <property name="max" value="140"/>
    <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
  </module>

  <!-- Evita tabs mezclados con espacios (usar solo espacios). -->
  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>

  <module name="TreeWalker">

    <!-- ================= Imports ================= -->

    <!-- No usar wildcards en imports (import java.util.*;). -->
    <module name="AvoidStarImport"/>

    <!-- Imports duplicados o no usados. -->
    <module name="UnusedImports">
      <property name="processJavadoc" value="true"/>
    </module>

    <!-- Imports en orden alfabético agrupados. -->
    <module name="ImportOrder">
      <property name="option" value="top"/>
      <property name="groups" value="java,javax,jakarta,org,com,*"/>
      <property name="ordered" value="true"/>
      <property name="separated" value="false"/>
      <property name="sortStaticImportsAlphabetically" value="true"/>
    </module>

    <!-- ================= Naming ================= -->

    <module name="TypeName"/>       <!-- Clases: PascalCase -->
    <module name="MethodName"/>     <!-- Métodos: camelCase -->
    <module name="LocalVariableName"/>
    <module name="MemberName"/>
    <module name="ParameterName"/>
    <module name="ConstantName"/>   <!-- static final: UPPER_SNAKE -->
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>

    <!-- ================= Whitespace ================= -->

    <module name="WhitespaceAround">
      <!-- Excepciones: llaves vacías y lambdas cortas están permitidas. -->
      <property name="allowEmptyConstructors" value="true"/>
      <property name="allowEmptyMethods" value="true"/>
      <property name="allowEmptyTypes" value="true"/>
      <property name="allowEmptyLoops" value="true"/>
      <property name="allowEmptyLambdas" value="true"/>
    </module>
    <module name="WhitespaceAfter"/>
    <module name="NoWhitespaceBefore"/>

    <!-- ================= Bloques ================= -->

    <!-- No permitir bloques vacíos (excepto catch bien documentados). -->
    <module name="EmptyBlock">
      <property name="option" value="text"/>
      <property name="tokens" value="LITERAL_TRY,LITERAL_FINALLY,LITERAL_IF,LITERAL_ELSE,LITERAL_FOR,LITERAL_WHILE,LITERAL_DO,STATIC_INIT,INSTANCE_INIT"/>
    </module>

    <!-- Siempre usar llaves en if/else/for/while (aunque el cuerpo sea de 1 línea). -->
    <module name="NeedBraces"/>

    <!-- Llave de apertura en la misma línea. -->
    <module name="LeftCurly"/>
    <module name="RightCurly"/>

    <!-- ================= Buenas prácticas ================= -->

    <!-- Sobrecargas de equals sin hashCode. -->
    <module name="EqualsHashCode"/>

    <!-- switch sin default. -->
    <module name="MissingSwitchDefault"/>

    <!-- Sin fall-through en switch (romper explícitamente). -->
    <module name="FallThrough"/>

    <!-- No usar magic numbers en el código (excepto 0, 1, -1, 2). -->
    <!-- Desactivado porque genera mucho ruido con Lombok + Spring. -->
    <!-- <module name="MagicNumber"/> -->

    <!-- Simplificar boolean expressions (return x == true → return x). -->
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>

    <!-- Evita String literal duplicado (más de 3 veces). -->
    <module name="MultipleStringLiterals">
      <property name="allowedDuplicates" value="3"/>
      <property name="ignoreStringsRegexp" value='^(""|" "|", "|"/"|":"|"\."|"-"|"_")$'/>
    </module>

  </module>
</module>
