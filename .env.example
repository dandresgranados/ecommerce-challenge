# ============================================================
# Plantilla de variables de entorno para docker-compose.
# Copiar como ".env" y ajustar los valores para producción real.
#     cp .env.example .env
# ============================================================

# --- Base de datos ---
DATABASE_NAME=ecommerce
DATABASE_USERNAME=ecommerce
DATABASE_PASSWORD=changeme

# --- JWT ---
# ⚠️ EN PRODUCCIÓN: cambiar por una clave larga y aleatoria (256 bits mínimo).
# Genera una con: openssl rand -base64 48
JWT_SECRET=cambia-esto-en-produccion-usa-una-clave-de-256-bits-o-mas

# --- Puertos ---
# Puerto en el host donde queda expuesto el frontend (nginx).
# El backend NO se expone al host por defecto (solo accesible via nginx).
FRONTEND_PORT=8080
